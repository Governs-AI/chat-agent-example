# Provider selection: "openrouter" | "openai" | "ollama".
# Unset: OpenRouter when OPENROUTER_API_KEY is set, otherwise Ollama.
PROVIDER=openrouter

# OpenRouter (OpenAI-compatible, https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id with tool support. Default: openai/gpt-4.1-nano
OPENROUTER_MODEL=openai/gpt-4.1-nano

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (OpenAI-compatible). Also the fallback when a hosted provider fails
# before answering; set OLLAMA_FALLBACK=false to surface the error instead.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Tool calling needs a model that supports it (llama3.1:8b, qwen2.5:3b+)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK=true

# Precheck & Platform API (uses same API key for authentication)
PRECHECK_URL=http://localhost:8082
GOVERNS_PRECHECK_BASE_URL=http://localhost:8082
# An API key created in the dashboard (Keys page). It authenticates precheck
# calls and the approval loop, and decides which org's policy applies.
PRECHECK_API_KEY=gai_your_dashboard_key
# Org the key belongs to — used when the OIDC token carries no org_id
GOVERNS_ORG_ID=

# MCP (optional, mock or local)
MCP_BASE_URL=http://localhost:9090

# Firecrawl API
FIRECRAWL_API_KEY=fc-your-api-key-here

# Platform API Configuration (for policy management)
# Note: Uses PRECHECK_API_KEY for authentication
PLATFORM_URL=http://localhost:3002

# Demo User Configuration (from seeded database)
DEMO_USER_ID=cmg6y0ie70001ikk227d049c7

# GovernsAI Authentication (OIDC)
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=http://localhost:3000
GOVERNSAI_CLIENT_ID=your-chatbot-client-id
GOVERNSAI_CLIENT_SECRET=your-chatbot-client-secret
